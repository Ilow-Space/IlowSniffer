{
  "manifest_version": 3,
  "name": "Ilöw Sniffer",
  "version": "2.0",
  "icons": {
    "128": "logo128.png"
  },
  "permissions": [
    "webRequest",
    "storage",
    "scripting",
    "activeTab",
    "cookies",
    "offscreen",
    "downloads",
    "declarativeNetRequest",
    "sidePanel",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://media.ilow.io/*"
  ],
  "background": {
    "service_worker": "src/adapters/background/BackgroundController.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>",
        "https://media.ilow.io/*",
        "https://id.ilow.io/*"
      ],
      "js": [
        "src/adapters/content/ContentScraper.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "side_panel": {
    "default_path": "popup.html"
  },
  "action": {}
}