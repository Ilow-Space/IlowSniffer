{
  "manifest_version": 3,
  "name": "Ilöw Sniffer",
  "version": "2.0",
  "icons": {
    "128": "logo128.png"
  },
  "permissions": [
    "webRequest",
    "storage",
    "scripting",
    "activeTab",
    "cookies",
    "offscreen",
    "downloads",
    "declarativeNetRequest",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://media.ilow.io/*"
  ],
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "assets/ContentScraper.js-loader-CrjXpbAN.js"
      ],
      "matches": [
        "<all_urls>",
        "https://media.ilow.io/*",
        "https://id.ilow.io/*"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "side_panel": {
    "default_path": "popup.html"
  },
  "action": {},
  "web_accessible_resources": [
    {
      "matches": [
        "<all_urls>",
        "https://id.ilow.io/*",
        "https://media.ilow.io/*"
      ],
      "resources": [
        "assets/ThumbnailGenerator-ChOvWGFT.js",
        "assets/Config-DHCPwQGR.js",
        "assets/ContentScraper.js-BMOBUaIt.js"
      ],
      "use_dynamic_url": false
    }
  ]
}
